# Python/backend
backend/.env
backend/*firebase*.json
!backend/firebase-credentials.example.json
backend/*service-account*.json
backend/venv/
backend/__pycache__/
backend/**/*.py[cod]
backend/.pytest_cache/
backend/pytest-cache-files-*/
backend/.mypy_cache/
backend/uploads/*
!backend/uploads/.gitkeep
!backend/uploads/README.md
backend/*.log

# Local databases and generated files
*.sqlite
*.sqlite3
*.db
*.log

# Editor/system noise
.DS_Store
Thumbs.db
.vscode/

# Android release signing secrets
frontend/android/key.properties
frontend/android/app/*.jks
frontend/android/app/*.keystore
# Flutter artefactos locales (no commitear)
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/.packages
frontend/build/
frontend/.pub-cache/
frontend/.metadata
frontend/coverage/

