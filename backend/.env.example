# === Base de datos ===
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/immunoclinic

# === Seguridad / JWT ===
SECRET_KEY=change-me-generate-unique-random-key-before-production
REFRESH_SECRET_KEY=change-me-generate-a-different-random-key-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DEBUG=true

# === Almacenamiento de archivos ===
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./uploads
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# === Email (SMTP) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@immunoclinic.local
EMAIL_ENABLED=false
SMTP_TIMEOUT_SECONDS=10

# === Email (SendGrid alternativo) ===
SENDGRID_API_KEY=

# === Firebase Cloud Messaging (push) ===
FIREBASE_CREDENTIALS_JSON=

# === Loop de recordatorios de vacuna ===
VACCINE_REMINDER_ENABLED=false

# === Deep link para reset de contrasena ===
FRONTEND_DEEP_LINK_BASE=immunoclinic://

# === CORS (separar por comas si hay varios origenes) ===
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# URL pública base del verificador. Producción requiere HTTPS.
# CERTIFICATE_VERIFY_BASE_URL=https://certificados.example.invalid/verify
